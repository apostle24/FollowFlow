rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User can only access their own user document and all nested subcollections
    match /users/{userId} {
      // User can read their own profile, but cannot tamper with plan/subscription status
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == 'free');
      allow update: if isAuthenticated() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'subscriptionStatus', 'isPro']);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
      
      match /contacts/{contactId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /followUps/{followUpId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /settings/{settingId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Subscription records are strictly read-only for clients, written server-side by verified Paystack webhook/verify
      match /subscription/{subscriptionId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if false;
      }

      match /scheduled_emails/{jobId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /analytics/{eventId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /sequences/{sequenceId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /sequenceEnrollments/{enrollmentId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /timeline/{timelineId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /leads/{leadId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /appointments/{appointmentId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Processed payments collection: written strictly server-side via Firebase Admin SDK for webhook idempotency
    match /processed_payments/{paymentRef} {
      allow read, write: if false;
    }
  }
}
